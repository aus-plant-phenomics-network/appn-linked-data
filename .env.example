# Copy to .env and fill in. NEVER commit .env (§3.9).
# Keys here must match the Configure table in the README exactly.
#
# Non-secret settings live in config/config.yaml. Any of them can be overridden
# here as APPN_EXAMPLE__<SECTION>__<KEY>. Load this file into your shell with:
#   set -a && source .env && set +a

# --- Secrets: dummy values only ---
# Real values come from the environment or a secrets manager, never from a file
# in the repository.
APPN_EXAMPLE__UPSTREAM__API_TOKEN=replace-me-do-not-commit-a-real-token

# --- Optional overrides of config/config.yaml ---
# APPN_EXAMPLE_CONFIG=config/config.yaml
# APPN_EXAMPLE__APP__LOG_LEVEL=DEBUG
# APPN_EXAMPLE__APP__LOG_FORMAT=text
# APPN_EXAMPLE__UPSTREAM__TIMEOUT_SECONDS=60
