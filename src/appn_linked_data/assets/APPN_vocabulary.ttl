appnid:pt_GravimetricPlantPhenotyping a skos:Concept,
        appn:PlatformType ;
    dcterms:description "A plant phenotyping platform consisting of weighing scales and automated irrigation units that monitors plant–pot weight and uses weight loss to determine transpiration and control irrigation." ;
