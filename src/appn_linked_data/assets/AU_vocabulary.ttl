    appn:lights "light 550   per shelf (2 shelves)" ;
    appn:physicalContainmentLevel appnid:pc_PC2 ;
    appn:shade "shades gen 1000 info" ;
    appn:temperatureRange "temperature range of 6 to 45 degree celcius lights on 4 to 45 degree celcius lights off " .

