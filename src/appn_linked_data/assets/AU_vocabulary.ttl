au:gf_GEN1000 a schema:IndividualProduct,
        skos:Concept,
        appn:GrowthFacility,
        appn:ObservationUnit,
        appn:Platform ;
    dcterms:description "Reach-in growth chamber (Conviron) with temperature range of temperature lights on 6 to 45 lights off 4 to 45. Size 0.53 m2 per shelf, lights light 550 per shelf (2 shelves). Shade shades gen 1000 info and PC2 containment level." ;
