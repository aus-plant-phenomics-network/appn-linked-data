au:scale_SeedSphericalRatioScale0To1 a schema:DefinedTerm,
        skos:Concept,
        appn:Scale ;
    dcterms:description "Seed spherical ratio scale. (0) Sphere shape; spherical ratio=0, infinitive long cylinder shape (seed shape), (1) Spherical ratio." ;
    dcterms:title "seed spherical ratio scale 0 to 1" ;
    schema:description "Seed spherical ratio scale. (0) Sphere shape; spherical ratio=0, infinitive long cylinder shape (seed shape), (1) Spherical ratio." ;
    schema:name "seed spherical ratio scale 0 to 1" ;
    skos:inScheme au:cs_Scale ;
    skos:prefLabel "seed spherical ratio scale 0 to 1 (Scale)" .

au:scale_SeedStructuralSimilarityScale0To1 a schema:DefinedTerm,
        skos:Concept,
        appn:Scale ;
    dcterms:description "Seed structural similarity scale. (0) not similar to the seed class at all, (1) identical with the seed class." ;
    dcterms:title "seed structural similarity scale 0 to 1" ;
    schema:description "Seed structural similarity scale. (0) not similar to the seed class at all, (1) identical with the seed class." ;
    schema:name "seed structural similarity scale 0 to 1" ;
    skos:inScheme au:cs_Scale ;
    skos:prefLabel "seed structural similarity scale 0 to 1 (Scale)" .

au:scale_SpikeSeedClassPercentageScale0To3 a schema:DefinedTerm,
        skos:Concept,
        appn:Scale ;
    dcterms:description "The percentage of grains classified as Seed Class 0 on this spike. ((Number of seeds in SeedClass0/Seednumber)*100%, (Number of seeds in SeedClass1/Seednumber)*100%,  (Number of seeds in SeedClass2/Seednumber)*100%, (Number of seeds in SeedClass3/Seednumber)*100%)." ;
    dcterms:title "spike seed class percentage scale 0 to 3" ;
    schema:description "The percentage of grains classified as Seed Class 0 on this spike. ((Number of seeds in SeedClass0/Seednumber)*100%, (Number of seeds in SeedClass1/Seednumber)*100%,  (Number of seeds in SeedClass2/Seednumber)*100%, (Number of seeds in SeedClass3/Seednumber)*100%)." ;
    schema:name "spike seed class percentage scale 0 to 3" ;
    skos:inScheme au:cs_Scale ;
    skos:prefLabel "spike seed class percentage scale 0 to 3 (Scale)" .

au:scale_SpikeSeedSphericalRatioAverage0To1 a schema:DefinedTerm,
        skos:Concept,
        appn:Scale ;
    dcterms:description "Spike seed spherical ratio average scale 0 = infinitive long cylinder shape, 1 = sphere shape." ;
    dcterms:title "spike seed spherical ratio average 0 to 1" ;
