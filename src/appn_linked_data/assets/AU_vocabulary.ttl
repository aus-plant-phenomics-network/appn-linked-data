au:method_ProjectedShootArea a schema:HowTo,
        skos:Concept,
        appn:Method ;
    dcterms:description "Calculated as the sum of the number of plant pixels from 3 camera views (LemnaTec Scanalyzer 3D) comprising two side views and aview from above, described by Brien et al. (2020) (https://doi.org/10.1186/s13007-020-00577-6), employing the R package growthPheno (Brien, 2021c) (http://cran.at.r-project.org/package=growthPheno)." ;
    dcterms:title "projected shoot area" ;
    schema:description "Calculated as the sum of the number of plant pixels from 3 camera views (LemnaTec Scanalyzer 3D) comprising two side views and aview from above, described by Brien et al. (2020) (https://doi.org/10.1186/s13007-020-00577-6), employing the R package growthPheno (Brien, 2021c) (http://cran.at.r-project.org/package=growthPheno)." ;
    schema:name "projected shoot area" ;
    skos:inScheme au:cs_Method ;
    skos:prefLabel "projected shoot area (Method)" .

